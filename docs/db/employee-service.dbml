// employee-service
// Схема БД сервиса сотрудников, отделов и должностей.
// Мультитенантность: каждая сущность принадлежит тенанту (tenant_id).
// См. ADR-0002.
// Идентификаторы — UUID v7 (Hibernate @UuidGenerator(style = TIME)).
//
// Телефон сотрудника — логин в рамках тенанта.
//   Ввод: 1231231212 (10 цифр, без +7).
//   Хранение: E.164 (+71231231212).
//   Отображение: +7 123 123 12 12.
//   Нормализация — на бэкенде, при сохранении/поиске.

Project prodman_employee_service {
  database_type: 'PostgreSQL'
  Note: 'Сотрудники, отделы, должности. Database-per-service. Shared schema + tenant_id.'
}

// -----------------------------
// Tenants (локальная проекция)
// -----------------------------
// Полноценный Tenant живёт в user-service. Здесь — только идентификатор
// для ссылочной целостности на уровне приложения (без FK).

Table tenants_ref {
  id uuid [pk, note: 'Совпадает с Tenant.id в user-service']

  Note: 'Проекция тенанта. Используется как цель ссылок tenant_id в других таблицах employee-service.'
}

// -----------------------------
// Departments
// -----------------------------
Table departments {
  id uuid [pk, note: 'UUID v7']
  tenant_id uuid [not null, ref: > tenants_ref.id]
  code varchar(64) [not null, note: 'Уникален в рамках тенанта']
  name varchar(255) [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, code) [unique, name: 'ux_departments_tenant_code']
    (tenant_id, is_active) [name: 'ix_departments_tenant_active']
  }
}

// -----------------------------
// Positions
// -----------------------------
Table positions {
  id uuid [pk, note: 'UUID v7']
  tenant_id uuid [not null, ref: > tenants_ref.id]
  code varchar(64) [not null, note: 'Уникален в рамках тенанта']
  name varchar(255) [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, code) [unique, name: 'ux_positions_tenant_code']
    (tenant_id, is_active) [name: 'ix_positions_tenant_active']
  }
}

// -----------------------------
// Employees
// -----------------------------
Table employees {
  id uuid [pk, note: 'UUID v7']
  tenant_id uuid [not null, ref: > tenants_ref.id]
  code varchar(64) [not null, note: 'Табельный номер. Уникален в рамках тенанта.']
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  middle_name varchar(100)
  phone varchar(16) [not null, note: 'E.164 без пробелов, например +71231231212. Логин в рамках тенанта.']
  hired_at date
  fired_at date
  status varchar(32) [not null, note: 'AVAILABLE | ACTIVE | ON_LEAVE | FIRED']
  department_id uuid [ref: > departments.id, note: 'Отдел сотрудника, может быть null']
  position_id uuid [ref: > positions.id, note: 'Текущая должность, может быть null']
  user_id uuid [note: 'Ссылка на user-service. Может быть null, если сотрудник без учётки.']
  max_consecutive_hours integer [not null, default: 12]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, code) [unique, name: 'ux_employees_tenant_code']
    (tenant_id, phone) [unique, name: 'ux_employees_tenant_phone']
    (tenant_id, status) [name: 'ix_employees_tenant_status']
    (tenant_id, department_id) [name: 'ix_employees_tenant_department']
    (tenant_id, position_id) [name: 'ix_employees_tenant_position']
  }
}

// -----------------------------
// Примечания
// -----------------------------
// - id — uuid (PostgreSQL). Генерируется приложением как UUID v7.
// - tenant_id — uuid, ссылка на user_service.tenants (без FK, разные БД).
// - Уникальные бизнес-ключи всегда составные: (tenant_id, code/phone).
// - Индексы на "горячих" полях — с tenant_id первым.
// - phone:
//     ввод (логин):  1231231212 (10 цифр, без +7)
//     хранение:      E.164, e.g. +71231231212
//     отображение:   +7 123 123 12 12
//     нормализация:  на бэкенде, при сохранении/поиске
// - qualifications (связь сотрудник ↔ должность с уровнем) добавим,
//   когда перейдём к расстановке по квалификации.