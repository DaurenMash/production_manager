<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.prodman.desktop.controller.MainController">

    <top>
        <MenuBar style="-fx-background-color: #2d2d3f;">
            <Menu style="-fx-text-fill: white;" text="Файл">
                <MenuItem onAction="#handleLogout" text="Сменить пользователя" />
                <SeparatorMenuItem />
                <MenuItem onAction="#handleExit" text="Выход" />
            </Menu>
            <Menu style="-fx-text-fill: white;" text="Данные">
                <MenuItem onAction="#showDashboardView" text="Дашборд" />
                <MenuItem onAction="#showEquipmentView" text="Оборудование" />
                <MenuItem onAction="#showReportsView" text="Отчеты" />
                <MenuItem onAction="#showWorkCalendarView" text="Календарь работы" />
                <MenuItem onAction="#showEmployeesView" text="Работники" />
            </Menu>
            <Menu style="-fx-text-fill: white;" text="Настройки">
                <MenuItem onAction="#showShiftSettings" text="Настройки смен" />
                <MenuItem onAction="#showWorkstationsView" text="Рабочие места" />
                <MenuItem onAction="#handleProfile" text="Профиль" />
                <MenuItem fx:id="usersMenuItem" onAction="#handleUsers" text="Пользователи" visible="false" />
            </Menu>
            <Menu style="-fx-text-fill: white;" text="Помощь">
                <MenuItem onAction="#handleAbout" text="О программе" />
            </Menu>
        </MenuBar>
    </top>

    <left>
        <VBox fx:id="leftVBox" prefWidth="220" spacing="10" style="-fx-background-color: #2d2d3f;">
            <padding>
                <Insets bottom="20" left="10" right="10" top="20" />
            </padding>

            <Text fill="#2E8B57" style="-fx-font-size: 40; -fx-font-weight: bold;" text="PRODMAN" VBox.vgrow="NEVER">
                <VBox.margin>
                    <Insets bottom="15" />
                </VBox.margin>
            </Text>

            <Button fx:id="dashboardButton" onAction="#showDashboardView" styleClass="nav-button" text="Дашборд" />
            <Button fx:id="equipmentButton" onAction="#showEquipmentView" styleClass="nav-button" text="Оборудование" />
            <Button fx:id="reportsButton" onAction="#showReportsView" styleClass="nav-button" text="Отчеты" />
            <Button fx:id="scheduleButton" onAction="#showScheduleView" styleClass="nav-button" text="График работ" />
            <Button fx:id="workCalendarButton" onAction="#showWorkCalendarView" styleClass="nav-button" text="Календарь работы" />
            <Button fx:id="settingsButton" onAction="#showSettingsView" styleClass="nav-button" text="Настройки" />
            <Button fx:id="usersButton" onAction="#showUsersView" styleClass="nav-button" text="Пользователи" />
            <Button fx:id="employeesButton" onAction="#showEmployeesView" styleClass="nav-button" text="Работники" />

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="10">
                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="userLabel" style="-fx-font-weight: bold;" text="User" textFill="white" />
                    <Label fx:id="roleLabel" style="-fx-font-size: 10;" text="Role" textFill="#aaaaaa" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="logout-button" text="Выйти" />
            </HBox>
            <ButtonBar prefHeight="40.0" prefWidth="200.0">
            <buttons>
               <ColorPicker />
            </buttons></ButtonBar>
        </VBox>
    </left>

    <center>
        <BorderPane fx:id="contentArea" style="-fx-background-color: #1e1e2f;" />
    </center>

</BorderPane>
