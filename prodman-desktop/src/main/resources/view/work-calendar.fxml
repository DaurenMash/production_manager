<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.prodman.desktop.controller.WorkCalendarController"
      spacing="15" style="-fx-background-color: #1e1e2f;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Text text="Календарь рабочего времени" fill="white" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="shiftConfigCombo"/>
        <Button text="Обновить" onAction="#refresh" style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 5;"/>
    </HBox>

    <!-- Calendar Controls -->
    <HBox alignment="CENTER" spacing="20">
        <Button text="◀" onAction="#previousMonth" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18;"/>
        <Label fx:id="monthLabel" text="Июнь 2026" textFill="white" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        <Button text="▶" onAction="#nextMonth" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18;"/>
        <Button text="Сегодня" onAction="#today" style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 5;"/>
    </HBox>

    <!-- Calendar Grid -->
    <ScrollPane style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <GridPane fx:id="calendarGrid" hgap="3" vgap="3"/>
    </ScrollPane>

    <!-- Conflicts Panel -->
    <VBox spacing="10" style="-fx-background-color: #2d2d3f; -fx-background-radius: 10;">
        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
        <Text text="⚠ Потенциальные проблемы" fill="#e74c3c" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
        <ListView fx:id="conflictsListView" prefHeight="100" style="-fx-background-color: #1e1e2f;"/>
    </VBox>

</VBox>