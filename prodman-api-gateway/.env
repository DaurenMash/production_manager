# Server
SERVER_PORT=8080

# JWT (должен совпадать с user-service)
JWT_SECRET=prodmanSuperSecretKey2025ForJWTGeneration512BitLong

# Redis - используем имя сервиса из docker-compose
REDIS_HOST=gateway-redis
REDIS_PORT=6379

# MongoDB - используем имя сервиса из docker-compose
MONGO_HOST=gateway-mongo
MONGO_PORT=27017
MONGO_DB=gateway_logs

# Logging
LOG_LEVEL=DEBUG